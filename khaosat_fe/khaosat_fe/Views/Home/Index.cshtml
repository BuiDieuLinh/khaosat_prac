@model khaosat_fe.Models.PagedResultViewModel<khaosat_fe.Models.AuditLogViewModel>

@{
    ViewData["Title"] = "Trang chủ - Portal Khảo Sát";
}

<div class="py-4">
    <div class="row g-4 mb-4">
        <div class="col-md-6">
            <div class="card h-100 border-0 shadow-sm">
                <div class="card-body p-4 d-flex flex-column justify-content-between">
                    <div>
                        <div class="d-flex align-items-center mb-3">
                            <div class="bg-light p-2 text-primary me-3 d-flex align-items-center justify-content-center" style="width: 42px; height: 42px; border-radius: 4px;">
                                <i class="dx-icon-selectall" style="font-size: 1.5rem;"></i>
                            </div>
                            <h5 class="card-title mb-0 fw-bold">Khảo sát của tôi</h5>
                        </div>
                        <p class="text-secondary small mb-4">Danh sách các cuộc khảo sát nhân sự đang khả dụng. Hãy thực hiện điền thông tin khảo sát để đóng góp ý kiến của bạn.</p>
                    </div>
                    <div>
                        <a href="@Url.Action("Index", "Survey")" class="btn btn-outline-primary btn-sm w-100">
                            Xem khảo sát khả dụng <i class="dx-icon-arrowright small ms-1"></i>
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="card h-100 border-0 shadow-sm">
                <div class="card-body p-4 d-flex flex-column justify-content-between">
                    <div>
                        <div class="d-flex align-items-center mb-3">
                            <div class="bg-light p-2 text-success me-3 d-flex align-items-center justify-content-center" style="width: 42px; height: 42px; border-radius: 4px;">
                                <i class="dx-icon-add" style="font-size: 1.5rem;"></i>
                            </div>
                            <h5 class="card-title mb-0 fw-bold">Thiết kế khảo sát</h5>
                        </div>
                        <p class="text-secondary small mb-4">Công cụ dành cho Admin và Nhân sự thiết lập mã khảo sát, định cấu trúc câu hỏi động, và phát hành biểu mẫu khảo sát trực tuyến.</p>
                    </div>
                    <div>
                        <a href="@Url.Action("Create", "Survey")" class="btn btn-outline-secondary btn-sm w-100" style="color: var(--success-color) !important; border-color: var(--success-color) !important;">
                            Tạo khảo sát mới <i class="dx-icon-add small ms-1"></i>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body p-4">
            <h5 class="card-title fw-bold mb-3"><i class="dx-icon-info small me-2 text-muted"></i> Hướng dẫn sử dụng nhanh</h5>
            <div class="row g-3">
                <div class="col-md-4">
                    <div class="border-start border-3 border-secondary ps-3 py-1">
                        <span class="d-block fw-bold text-dark small">Bước 1: Đăng nhập</span>
                        <p class="text-muted small mb-0">Sử dụng Mã nhân viên và mật khẩu được cấp để truy cập hệ thống.</p>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="border-start border-3 border-secondary ps-3 py-1">
                        <span class="d-block fw-bold text-dark small">Bước 2: Chọn khảo sát</span>
                        <p class="text-muted small mb-0">Truy cập menu Khảo sát, xem danh sách khảo sát đang mở và bấm "Làm khảo sát".</p>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="border-start border-3 border-secondary ps-3 py-1">
                        <span class="d-block fw-bold text-dark small">Bước 3: Điền & gửi kết quả</span>
                        <p class="text-muted small mb-0">Trả lời đầy đủ các tiêu chí bắt buộc và nhấn "Gửi khảo sát" để hoàn thành.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>

    @if (User.IsInRole("Admin"))
    {
        <div class="card shadow-sm border-0 rounded-3">
            <div class="card-body p-4">
                <h5 class="card-title fw-bold mb-3 d-flex align-items-center">
                    <i class="dx-icon-doc text-primary me-2 fs-5"></i> Hoạt động gần đây
                </h5>
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th style="width: 170px;">Thời gian</th>
                                <th style="width: 160px;">Người thực hiện</th>
                                <th style="width: 220px;">Hành động (Action)</th>
                                <th>Chi tiết khảo sát</th>
                                <th style="width: 140px;">IP Address</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model == null || Model.Data == null || !Model.Data.Any())
                            {
                                <tr>
                                    <td colspan="5" class="text-center py-4 text-muted">Chưa có nhật ký hoạt động nào.</td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var log in Model.Data)
                                {
                                    <tr>
                                        <td class="small text-muted">@log.CreatedAt.ToString("dd/MM/yyyy HH:mm:ss")</td>
                                        <td>
                                            <span class="fw-semibold text-dark">@(string.IsNullOrEmpty(log.UserName) ? "Hệ thống / Public" : log.UserName)</span>
                                        </td>
                                        <td>
                                            @if (log.Action == "SUBMIT_SURVEY")
                                            {
                                                <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1 rounded-pill"><i class="dx-icon-check me-1"></i>Nộp khảo sát</span>
                                            }
                                        </td>
                                        <td class="small">
                                            <span class="text-dark fw-semibold">@log.EntityType:</span>
                                            <span class="text-muted">#@(log.EntityId?.Length > 12 ? log.EntityId.Substring(0, 8) + "..." : log.EntityId)</span>
                                        </td>
                                        <td class="small text-muted font-monospace">@(log.IpAddress ?? "127.0.0.1")</td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
    
</div>
