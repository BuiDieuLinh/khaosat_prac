@{
    ViewData["Title"] = "Quản lý nhân sự";
}

<div class="mb-4 d-flex justify-content-between align-items-center">
    <div>
        <h1 class="fw-bold text-dark mb-1 fs-3">@ViewData["Title"]</h1>
        <p class="text-muted mb-0 small">Quản lý tài khoản, chức vụ, trạng thái và phân quyền vai trò cho mỗi nhân sự.</p>
    </div>
    <div>
        @(Html.DevExtreme().Button()
            .ID("btnAddEmployee")
            .Text("Thêm nhân sự")
            .Icon("add")
            .Type(ButtonType.Default)
            .OnClick("addEmployee")
        )
    </div>
</div>

<div class="card employee-card">
    <div class="card-body p-0">
        @(Html.DevExtreme().DataGrid<khaosat_fe.Models.EmployeeViewModel>()
            .ID("employeeGrid")
            .DataSource(ds => ds.Mvc()
                .Controller("Employee")
                .LoadAction("GetEmployees")
                .InsertAction("Create")
                .UpdateAction("Update")
                .DeleteAction("Delete")
                .Key("Id")
            )
            .KeyExpr("Id")
            .ShowBorders(false)
            .ShowRowLines(true)
            .ShowColumnLines(false)
            .RowAlternationEnabled(false)
            .WordWrapEnabled(true)
            .ColumnAutoWidth(true)
            .HoverStateEnabled(true)
            .NoDataText("Chưa có nhân sự nào.")
            .Paging(p => p.PageSize(10))
            .Pager(p => p
                .ShowPageSizeSelector(true)
                .AllowedPageSizes(new[] { 5, 10, 20 })
                .ShowInfo(true)
                .InfoText("Trang {0}/{1} ({2} nhân sự)")
            )
            .SearchPanel(s => s.Visible(true).Width(300).Placeholder("Tìm kiếm nhân sự..."))
            .HeaderFilter(hf => hf.Visible(true))
            .Columns(columns =>
            {
                columns.AddFor(m => m.FullName)
                    .Caption("Nhân sự")
                    .MinWidth(180)
                    .Alignment(HorizontalAlignment.Left)
                    .CellTemplate(@<text>
                        <div class="d-flex align-items-center gap-2 py-1">
                            <div class="employee-avatar-circle">
                                <%- (data.FullName || 'N').charAt(0).toUpperCase() %>
                            </div>
                            <div class="d-flex flex-column ms-1">
                                <span class="fw-bold text-dark" style="font-size: 0.92rem;"><%- data.FullName %></span>
                                <span class="text-muted small" style="font-size: 0.78rem;"><%- data.Email %></span>
                            </div>
                        </div>
                    </text>);

                columns.AddFor(m => m.EmployeeCode)
                    .Caption("Mã NV")
                    .Width(130)
                    .Alignment(HorizontalAlignment.Left)
                    .CellTemplate(@<text>
                        <span class="employee-code"><%- data.EmployeeCode %></span>
                    </text>);

                columns.AddFor(m => m.Email)
                    .Caption("Email")
                    .Visible(false);

                columns.AddFor(m => m.DepartmentId)
                    .Caption("Phòng ban")
                    .Visible(false);

                columns.AddFor(m => m.PositionId)
                    .Caption("Chức vụ (ID)")
                    .Visible(false);

                columns.AddFor(m => m.RoleIds)
                    .Caption("Vai trò (IDs)")
                    .Visible(false);

                columns.AddFor(m => m.PositionName)
                    .Caption("Chức vụ")
                    .Width(220)
                    .CellTemplate(@<text>
                        <span class="badge-position">
                            <%- data.PositionName || 'Chưa phân công' %>
                        </span>
                    </text>);

                columns.AddFor(m => m.IsActive)
                    .DataField("IsActive")
                    .Caption("Trạng thái")
                    .Width(200)
                    .Alignment(HorizontalAlignment.Center)
                    .CellTemplate(@<text>
                        <span class="badge-status <%- data.IsActive ? 'status-active' : 'status-inactive' %>">
                            <span class="status-dot"></span>
                            <%- data.IsActive ? 'Đang hoạt động' : 'Ngừng hoạt động' %>
                        </span>
                    </text>
                );

                columns.Add()
                    .Type(GridCommandColumnType.Buttons)
                    .Caption("Thao tác")
                    .Width(120)
                    .Buttons(buttons =>
                    {
                        buttons.Add()
                            .Icon("edit")
                            .Hint("Chỉnh sửa")
                            .OnClick("editEmployee");

                        buttons.Add()
                            .Icon("trash")
                            .Hint("Xóa")
                            .OnClick("deleteEmployee");
                    });
            })
            .Editing(e => e
                .AllowUpdating(true)
                .AllowDeleting(true)
            )
        )
    </div>
</div>

@(Html.DevExtreme().Popup()
    .ID("employeePopup")
    .Title("Nhân sự")
    .Visible(false)
    .OnShown("employeePopupShown")
    .Width(700)
    .Height(650)
    .ShowCloseButton(true)
    .ToolbarItems(toolbar =>
    {
        toolbar.Add()
            .Widget(w => w.Button()
                .Text("Lưu")
                .Type(ButtonType.Success)
                .Icon("save")
                .OnClick("saveEmployee")
            )
            .Location(ToolbarItemLocation.After)
            .Toolbar(Toolbar.Bottom);

        toolbar.Add()
            .Widget(w => w.Button()
                .Text("Hủy")
                .Icon("close")
                .OnClick("cancelEmployee")
            )
            .Location(ToolbarItemLocation.After)
            .Toolbar(Toolbar.Bottom);
    })
    .ContentTemplate(@<text>

        @(Html.DevExtreme().Form<EmployeeViewModel>()
            .ID("employeeForm")
            .LabelLocation(FormLabelLocation.Top)
            .ColCount(2)
            .Items(items =>
            {
                items.AddSimpleFor(x => x.EmployeeCode);
                items.AddSimpleFor(x => x.FullName);
                items.AddSimpleFor(x => x.Email)
                    .Editor(e => e.TextBox()
                        .Mode(TextBoxMode.Email)
                        .Option("validationMessageMode", "always")
                        .Option("validationMessagePosition", "bottom")
                    );
                items.AddSimpleFor(x => x.DepartmentId)
                    .Editor(e => e.SelectBox()
                        .DataSource(new JS("departmentData"))
                        .ValueExpr("Id")
                        .DisplayExpr("DepartmentName")
                        .OnValueChanged("departmentChanged")
                    );
                items.AddSimpleFor(x => x.PositionId)
                    .Editor(e => e.SelectBox()
                        .ValueExpr("Id")
                        .DisplayExpr("PositionName")
                    );
                items.AddSimpleFor(x => x.RoleIds)
                    .Editor(e => e.TagBox()
                        .DataSource(d => d.Mvc()
                            .Controller("Employee")
                            .LoadAction("GetRoles"))
                        .ValueExpr("Id")
                        .DisplayExpr("RoleName")
                    );
                items.AddSimpleFor(x => x.IsActive)
                    .Editor(e => e.CheckBox());
            })
        )
    </text>)
)


@(Html.DevExtreme().Toast()
    .ID("toastEmployee")
    .DisplayTime(3000)
    .Width(350)
    .Position(p => p
    .My(HorizontalAlignment.Right, VerticalAlignment.Top)
    .At(HorizontalAlignment.Right, VerticalAlignment.Top)
    .Offset(-20, 20)
    )
)

<script>
    var departmentData = [];
    window.Employee = window.Employee || {};
    window.Employee.Urls = {
        roles: "@Url.Action("GetRoles", "Employee")",
        create: "@Url.Action("Create", "Employee")",
        update: "@Url.Action("Update", "Employee")",
        delete: "@Url.Action("Delete", "Employee")",
        departments: "@Url.Action("GetDepartments", "Department")",
        positions: "@Url.Action("GetPositions", "Department")"
    };
</script>

<script src="~/js/common.js" asp-append-version="true"></script>
<script src="~/js/employee/employee-constant.js" asp-append-version="true"></script>
<script src="~/js/employee/employee-api.js" asp-append-version="true"></script>
<script src="~/js/employee/employee-page.js" asp-append-version="true"></script>



