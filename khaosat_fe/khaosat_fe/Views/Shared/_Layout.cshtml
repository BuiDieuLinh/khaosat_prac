@inject IConfiguration Configuration
@{
    var apiBaseUrl = (Configuration.GetValue<string>("ApiSettings:BaseUrl") ?? "https://localhost:44327/").TrimEnd('/');
    var notificationHubUrl = $"{apiBaseUrl}/hubs/notification";
    var notificationAccessToken = User.FindFirst("Token")?.Value;
}
<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>@ViewData["Title"] - Quản Lý Khảo Sát</title>
        <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
        <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
        <link rel="stylesheet" href="~/khaosat_fe.styles.css" asp-append-version="true" />
        <link rel="stylesheet" href="~/css/devextreme/dx.light.css" asp-append-version="true" />
        <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
        <script src="~/lib/jquery/dist/jquery.min.js"></script>
        <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
        <script src="~/js/site.js" asp-append-version="true"></script>
        <script src="~/js/devextreme/dx.all.js"></script>
        <script src="~/js/devextreme/aspnet/dx.aspnet.data.js"></script>
        <script src="~/js/devextreme/aspnet/dx.aspnet.mvc.js"></script>
        <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
        <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
        <script src="~/js/common.js" asp-append-version="true"></script>
        <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.7/signalr.min.js"></script>
    </head>
    <body>
        <header>
            <nav class="navbar navbar-expand-md navbar-light bg-white mb-4 py-2 border-bottom">
                <div class="container px-4">
                    <a class="navbar-brand d-flex align-items-center" asp-area="" asp-controller="Home" asp-action="Index">
                        <span>PORTAL KHẢO SÁT</span>
                    </a>
                    <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                        <span class="navbar-toggler-icon"></span>
                    </button>
                    <div class="navbar-collapse collapse d-md-inline-flex justify-content-between">
                        <ul class="navbar-nav me-auto mb-2 mb-md-0 gap-1">
                            <li class="nav-item">
                                <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Home" && ViewContext.RouteData.Values["action"]?.ToString() == "Index" ? "active" : "")" asp-area="" asp-controller="Home" asp-action="Index">
                                    <i class="dx-icon-home me-1 small"></i> Trang chủ
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Survey" ? "active" : "")" asp-area="" asp-controller="Survey" asp-action="Index">
                                    <i class="dx-icon-selectall me-1 small"></i> Danh sách khảo sát
                                </a>
                            </li>
                            @if (User.IsInRole("Admin") || User.IsInRole("Quản lý"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Employee" ? "active" : "")" asp-area="" asp-controller="Employee" asp-action="Index">
                                        <i class="dx-icon-group me-1 small"></i> Quản lý Nhân sự
                                    </a>
                                </li>
                            }
                        </ul>
                        <div class="d-flex align-items-center gap-3">
                            <div class="dropdown">
                                <button class="btn position-relative d-flex align-items-center justify-content-center"
                                        type="button"
                                        id="notificationDropdown"
                                        data-bs-toggle="dropdown"
                                        aria-expanded="false"
                                        style="width: 20px; height: 25px; border-radius: 50% !important; background-color: transparent;">

                                    <i id="notificationBellIcon" class="dx-icon-bell"></i>

                                    <span id="notificationBadge"
                                          class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger d-none"
                                          style="font-size: 0.65rem;">
                                        0
                                    </span>
                                </button>     

                                <div class="dropdown-menu dropdown-menu-end shadow"
                                     aria-labelledby="notificationDropdown"
                                     style="width: 350px; max-height: 450px; overflow-y: auto;">

                                    <div class="d-flex justify-content-between align-items-center px-3 py-2 border-bottom">
                                        <span class="fw-semibold">
                                            Thông báo
                                        </span>

                                        <button type="button"
                                                id="markAllAsReadBtn"
                                                class="btn btn-link btn-sm text-decoration-none p-0">
                                            Đánh dấu đã đọc
                                        </button>
                                    </div>

                                    <div id="notificationList">
                                        <div class="text-center text-muted py-4">
                                            Không có thông báo
                                        </div>
                                    </div>

                                </div>
                            </div>

                            @if (User.Identity?.IsAuthenticated == true)
                            {
                                var userRoles = User.FindAll(System.Security.Claims.ClaimTypes.Role).Select(c => c.Value).ToList();
                                <div class="text-end me-1">
                                    <div class="d-flex align-items-center justify-content-end gap-1">
                                        <span class="text-dark fw-semibold small" style="font-size: 0.85rem;">@User.Identity.Name</span>
                                    </div>
                                    <span class="text-muted d-block small" style="font-size: 0.73rem; line-height: 1.2;">
                                        Quyền: @(userRoles.Any() ? string.Join(" • ", userRoles) : "Nhân viên")
                                    </span>
                                </div>
                                <a class="btn btn-outline-danger btn-sm d-flex align-items-center gap-1 ms-1" asp-controller="Auth" asp-action="Logout">
                                    <i class="dx-icon-runner small"></i> Đăng xuất
                                </a>
                            }
                            else
                            {
                                <a class="btn btn-primary btn-sm d-flex align-items-center gap-1" asp-controller="Auth" asp-action="Login">
                                    <i class="dx-icon-user small"></i> Đăng nhập
                                </a>
                            }
                        </div>
                    </div>
                </div>
            </nav>
        </header>
        <div class="container mb-5">
            <main role="main" class="pb-3">
                @RenderBody()
            </main>
            <partial name="_Toast.cshtml" />
        </div>

        <footer class="footer text-muted py-3 bg-white">
            <div class="container text-center text-md-start d-md-flex justify-content-between align-items-center">
                <span class="small">&copy; 2026 - Portal Khảo Sát Nhân Sự. Tất cả quyền được bảo lưu.</span>
                <div class="mt-2 mt-md-0 small">
                    <a asp-area="" asp-controller="Home" asp-action="Privacy" class="text-muted me-3">Chính sách bảo mật</a>
                    <a href="#" class="text-muted">Hỗ trợ kỹ thuật</a>
                </div>
            </div>
        </footer>
    <script>
        $(document).ajaxError(function (event, jqXHR, ajaxSettings, thrownError) {
        if (jqXHR.status === 401) {
                    window.location.href = '@Url.Action("Login", "Auth")';
            }
        });
    </script>
    <script>
        window.notificationHubOptions = {
            url: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(notificationHubUrl)),
            accessToken: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(notificationAccessToken))
        };
    </script>
    <script src="~/js/notification.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
