@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Đăng nhập - Hệ thống khảo sát</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/devextreme/dx.light.css" asp-append-version="true" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/js/devextreme/dx.all.js"></script>
    
    <style>
        body {
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0;
            background-color: #f8fafc;
            color: #0f172a;
        }

        .login-card {
            background: #ffffff;
            border: 1px solid #cbd5e1;
            border-radius: 6px;
            padding: 2.5rem 2.25rem;
            width: 100%;
            max-width: 400px;
            box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05), 0 2px 4px -1px rgba(0, 0, 0, 0.03);
            animation: fadeIn 0.3s ease-out;
        }

        @@keyframes fadeIn {
            from { opacity: 0; transform: translateY(4px); }
            to { opacity: 1; transform: translateY(0); }
        }

        .login-brand-icon {
            width: 44px;
            height: 44px;
            background: #eff6ff;
            border: 1px solid #bfdbfe;
            border-radius: 8px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            color: #1e40af;
            font-size: 1.35rem;
            margin-bottom: 0.85rem;
        }

        .login-header h2 {
            font-weight: 700;
            color: #0f172a;
            margin-bottom: 0.3rem;
            letter-spacing: -0.02em;
            font-size: 1.5rem;
        }

        .login-header p {
            color: #64748b;
            font-size: 0.88rem;
            margin-bottom: 1.85rem;
        }

        .form-label {
            font-size: 0.85rem;
            font-weight: 600;
            color: #334155;
            margin-bottom: 0.4rem;
            display: block;
        }

        .dx-textbox, .dx-button {
            border-radius: 4px !important;
        }

        .dx-texteditor-input {
            font-size: 0.9rem !important;
            padding: 9px 12px !important;
        }

        .login-btn {
            background-color: #1e40af !important;
            border: 1px solid #1e40af !important;
            color: #ffffff !important;
            font-weight: 600 !important;
            height: 40px !important;
            transition: background-color 0.15s ease !important;
            border-radius: 4px !important;
        }

        .login-btn:hover {
            background-color: #1e3a8a !important;
            border-color: #1e3a8a !important;
        }

        .error-message {
            background-color: #fef2f2;
            border: 1px solid #fca5a5;
            color: #b91c1c;
            padding: 0.75rem 1rem;
            border-radius: 4px;
            font-size: 0.85rem;
            margin-bottom: 1.25rem;
            display: none;
        }
    </style>
</head>
<body>

    <div class="login-card">
        <div class="login-header text-center">
            <h2>KHAO SAT PORTAL</h2>
            <p>Đăng nhập hệ thống quản lý khảo sát nhân sự</p>
        </div>

        @if (!string.IsNullOrEmpty(ViewBag.ErrorMessage as string))
        {
            <div class="error-message" style="display: block;">@ViewBag.ErrorMessage</div>
        }
        else
        {
            <div id="errorMessage" class="error-message"></div>
        }

        <div class="mb-3">
            <label class="form-label">Mã nhân viên</label>
            <div id="usernameInput"></div>
        </div>

        <div class="mb-4">
            <label class="form-label">Mật khẩu</label>
            <div id="passwordInput"></div>
        </div>

        <div class="mb-3 mt-4">
            <div id="loginBtn"></div>
        </div>
    </div>
    <partial name="~/Views/Shared/_Toast.cshtml" />

    <script>
        window.Survey = window.Survey || {};
        window.Survey.Urls = {
            login: "@Url.Action("Login", "Auth")",
            surveyIndex: "@Url.Action("Index", "Survey")"
        };
    </script>

    <script src="~/js/common.js" asp-append-version="true"></script>
    <script src="~/js/auth/auth-constants.js" asp-append-version="true"></script>
    <script src="~/js/auth/auth-api.js" asp-append-version="true"></script>
    <script src="~/js/auth/auth-validation.js" asp-append-version="true"></script>
    <script src="~/js/auth/auth-page.js" asp-append-version="true"></script>

</body>
</html>
