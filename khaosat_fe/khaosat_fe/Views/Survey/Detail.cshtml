@model khaosat_fe.Models.SurveyDetailViewModel
@using System.Text.Json
@using DevExtreme.AspNet.Mvc

@{
ViewData["Title"] = Model.Name;
}

<div class="mb-4">
    <a href="@Url.Action("Index", "Survey")" class="btn btn-outline-secondary mb-3">
        <i class="dx-icon-arrowleft"></i> Quay lại danh sách
    </a>
    <div class="card shadow-sm p-4">
        <h1 class="h3 fw-bold mb-2">@Model.Name</h1>
        <p class="text-secondary mb-0">@Model.Description</p>
        <div class="mt-3 pt-2 border-top text-secondary small d-flex flex-wrap gap-3">
            <span>Mã khảo sát: <strong class="text-dark">@Model.Code</strong></span>
            @if (Model.StartDate.HasValue)
            {
                <span>Bắt đầu: <strong class="text-dark">@Model.StartDate.Value.ToString("dd/MM/yyyy HH:mm")</strong></span>
            }
            @if (Model.EndDate.HasValue)
            {
                <span>Kết thúc: <strong class="text-dark">@Model.EndDate.Value.ToString("dd/MM/yyyy HH:mm")</strong></span>
            }
        </div>
    </div>
</div>

<!-- Thông tin người thực hiện -->
<div class="card shadow-sm mb-4">
    <div class="card-body p-4">
        <h5 class="card-title fw-bold mb-3 d-flex align-items-center">
            <i class="dx-icon-user me-2 text-primary"></i> Thông tin người thực hiện khảo sát
        </h5>
        <div class="row g-3">
            <div class="col-md-6">
                <label class="form-label text-secondary fw-semibold small mb-1">Họ và Tên:</label>
                <p class="form-control-plaintext text-dark fw-bold mb-0">@User.Identity?.Name</p>
            </div>
            <div class="col-md-6">
                <label class="form-label text-secondary fw-semibold small mb-1">Mã nhân viên:</label>
                <p class="form-control-plaintext text-dark fw-bold mb-0">@User.FindFirst(System.Security.Claims.ClaimTypes.UserData)?.Value</p>
            </div>
        </div>
        <input type="hidden" id="employeeId" value="@User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value" />
    </div>
</div>

<!-- Form khảo sát động -->
<div class="card shadow-sm mb-4">
    <div class="card-body p-4">
        <h5 class="card-title fw-bold text-dark border-bottom pb-3 mb-4">Nội dung khảo sát</h5>
        <form id="surveyForm">
            @{ int questionIndex = 1; }
            @foreach (var element in Model.Elements.OrderBy(x => x.SortOrder))
            {
                Dictionary<string, object>? config = null;
                try
                {
                    config = JsonSerializer.Deserialize<Dictionary<string, object>>(element.ConfigType);
                }
                catch {}

                config ??= new Dictionary<string, object>();

                string dataTypeRaw = config.ContainsKey("DataType") ? config["DataType"]?.ToString() ?? "Textbox" : "Textbox";
                string dataType = dataTypeRaw;
                bool isMultiSelect = false;
                if (config.ContainsKey("IsMultiSelect") && config["IsMultiSelect"] is JsonElement multiJson)
                {
                    isMultiSelect = multiJson.ValueKind == JsonValueKind.True;
                }

                if (dataType.Equals("Text", StringComparison.OrdinalIgnoreCase) || dataType.Equals("string", StringComparison.OrdinalIgnoreCase))
                {
                    dataType = "Textbox";
                }
                else if (dataType.Equals("Checkbox", StringComparison.OrdinalIgnoreCase) || dataType.Equals("Checkbox", StringComparison.OrdinalIgnoreCase))
                {
                    dataType = "Checkbox";
                    isMultiSelect = true;
                }
                else if (dataType.Equals("Radio", StringComparison.OrdinalIgnoreCase) || dataType.Equals("RadioList", StringComparison.OrdinalIgnoreCase))
                {
                    dataType = "Radio";
                    isMultiSelect = false;
                }

                string caption = config.ContainsKey("Caption") ? config["Caption"]?.ToString() ?? element.FieldName : element.FieldName;
                string inputHelper = config.ContainsKey("InputHelper") ? config["InputHelper"]?.ToString() ?? "" : "";
                string helperText = config.ContainsKey("Helper") ? config["Helper"]?.ToString() ?? "" : "";
                bool allowNull = !config.ContainsKey("AllowNull") || config["AllowNull"] is not JsonElement valJson || valJson.ValueKind != JsonValueKind.False;

                <div class="mb-3 p-3 question-block bg-white border-bottom">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <label class="form-label text-dark fw-semibold mb-0" style="font-size: 0.95rem;">
                            @(questionIndex++). @caption
                            @if (!allowNull)
                            {
                                <span class="text-danger">*</span>
                            }
                        </label>
                    </div>

                    @if (element.Options != null && element.Options.Count > 0)
                    {
                        if (isMultiSelect)
                        {
                            @(Html.DevExtreme().List()
                            .ID("element_" + element.Id)
                            .DataSource(element.Options)
                            .KeyExpr("Value")
                            .DisplayExpr("DisplayText")
                            .SelectionMode(ListSelectionMode.Multiple)
                            .ShowSelectionControls(true)
                            .Height("auto")
                            .OnSelectionChanged("function(e) { " +
                                "var selectedKeys = e.component.option('selectedItemKeys'); " +
                                "var val = (selectedKeys && selectedKeys.length) ? JSON.stringify(selectedKeys) : ''; " +
                                "$('#hidden_element_" + element.Id + "').val(val).trigger('change'); " +
                                "if (window.jQuery && $.fn.validate) { $('#hidden_element_" + element.Id + "').valid(); }" +
                            "}")
                            )
                            <input type="hidden" id="hidden_element_@element.Id" name="element_@element.Id" />
                        }
                        else
                        {
                            @(Html.DevExtreme().RadioGroup()
                            .ID("element_" + element.Id)
                            .Name("element_" + element.Id)
                            .DataSource(element.Options)
                            .ValueExpr("Value")
                            .DisplayExpr("DisplayText")
                            .OnValueChanged("function(e) { if (window.jQuery && $.fn.validate) { $('[name=\"element_" + element.Id + "\"]').valid(); } }")
                            )
                        }
                    }
                    else if (dataType == "Number")
                    {
                        @(Html.DevExtreme().NumberBox()
                        .ID("element_" + element.Id)
                        .Name("element_" + element.Id)
                        .Placeholder(inputHelper)
                        )
                    }
                    else if (dataType == "Date")
                    {
                        @(Html.DevExtreme().DateBox()
                        .ID("element_" + element.Id)
                        .Name("element_" + element.Id)
                        .Type(DateBoxType.Date)
                        .DisplayFormat("dd/MM/yyyy")
                        .Placeholder(inputHelper)
                        )
                    }
                    else if (dataType == "TextArea")
                    {
                        @(Html.DevExtreme().TextArea()
                        .ID("element_" + element.Id)
                        .Name("element_" + element.Id)
                        .Placeholder(inputHelper)
                        .Height(80)
                        )
                    }
                    else
                    {
                        @(Html.DevExtreme().TextBox()
                        .ID("element_" + element.Id)
                        .Name("element_" + element.Id)
                        .Placeholder(inputHelper)
                        )
                    }

                    @* @if (!string.IsNullOrEmpty(helperText))
                    {
                        <div class="form-text text-muted mt-2 small" style="font-size: 0.8rem;"><i class="dx-icon-info small me-1"></i>@helperText</div>
                    } *@
                </div>
            }

            <div class="mt-4 pt-3 border-top d-flex justify-content-end">
                @(Html.DevExtreme().Button()
                .Text("Gửi khảo sát")
                .Type(ButtonType.Success)
                .Icon("check")
                .Width(180)
                .Height(42)
                .OnClick("window.Survey.Event.submitSurvey")
                )
            </div>
        </form>
    </div>
</div>

@(Html.DevExtreme().Toast()
.ID("toastDetail")
.DisplayTime(3000)
.Width(320)
.Position(p => p
.My(HorizontalAlignment.Right, VerticalAlignment.Top)
.At(HorizontalAlignment.Right, VerticalAlignment.Top)
.Offset(-20, 20)
)
)

<script>
    window.Survey = window.Survey || {};
    window.Survey.surveyId = "@Model.Id";
    window.Survey.surveyElements = [
    @foreach (var element in Model.Elements)
    {
        Dictionary<string, object>? config = null;
        try { config = JsonSerializer.Deserialize<Dictionary<string, object>>(element.ConfigType); } catch {}
        config ??= new Dictionary<string, object>();

        string dataTypeRaw = config.ContainsKey("DataType") ? config["DataType"]?.ToString() ?? "TextBox" : "TextBox";
        string dataType = dataTypeRaw;
        bool isMultiSelect = false;
        if (config.ContainsKey("IsMultiSelect") && config["IsMultiSelect"] is JsonElement multiJson)
        {
            isMultiSelect = multiJson.ValueKind == JsonValueKind.True;
        }

        if (dataType.Equals("Text", StringComparison.OrdinalIgnoreCase) || dataType.Equals("string", StringComparison.OrdinalIgnoreCase))
        {
            dataType = "TextBox";
        }
        else if (dataType.Equals("Checkbox", StringComparison.OrdinalIgnoreCase) || dataType.Equals("CheckBox", StringComparison.OrdinalIgnoreCase))
        {
            dataType = "Select";
            isMultiSelect = true;
        }
        else if (dataType.Equals("Radio", StringComparison.OrdinalIgnoreCase) || dataType.Equals("RadioList", StringComparison.OrdinalIgnoreCase))
        {
            dataType = "Select";
            isMultiSelect = false;
        }

        bool hasOptions = element.Options != null && element.Options.Count > 0;
        string caption = config.ContainsKey("Caption") ? config["Caption"]?.ToString() ?? element.FieldName : element.FieldName;
        bool allowNull = !config.ContainsKey("AllowNull") || config["AllowNull"] is not JsonElement valJson || valJson.ValueKind != JsonValueKind.False;

        <text>
            {
                id: "@element.Id",
                fieldName: "@element.FieldName",
                caption: @Html.Raw(JsonSerializer.Serialize(caption)),
                dataType: "@dataType",
                required: @(allowNull ? "false" : "true"),
                hasOptions: @(hasOptions ? "true" : "false"),
                isMultiSelect: @(isMultiSelect ? "true" : "false"),
                options: [
                @if (hasOptions)
                {
                    foreach (var opt in element.Options!)
                    {
                        <text>
                            {
                                id: "@opt.Id",
                                value: "@opt.Value"
                                },
                            </text>
                        }
                    }
                    ]
                    },
                </text>
            }
            ];

            window.Survey.Urls = {
            submit: "@Url.Action("Submit", "Survey")",
            index: "@Url.Action("Index", "Survey")"
            };
        </script>

        @await Html.PartialAsync("_ValidationScriptsPartial")
        <script src="~/js/common.js" asp-append-version="true"></script>
        <script src="~/js/survey.js" asp-append-version="true"></script>