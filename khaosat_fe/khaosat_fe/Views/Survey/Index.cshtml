@{
    ViewData["Title"] = "Danh sách khảo sát";
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show mb-4" role="alert">
        <i class="dx-icon-info small me-1"></i> @TempData["ErrorMessage"]
        <button type="button" class="btn-close text-dark shadow-none" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="mb-3 d-flex justify-content-between align-items-center">
    <div>
        <h1 class="fw-bold text-dark mb-1">@ViewData["Title"]</h1>
        <p class="text-muted mb-0">Vui lòng chọn khảo sát khả dụng bên dưới để thực hiện.</p>
    </div>
    @if (User.IsInRole("Admin") || User.IsInRole("Quản lý"))
    {
        <div>
            @(Html.DevExtreme().Button()
                .Text("Tạo khảo sát mới")
                .Icon("add")
                .Type(ButtonType.Default)
                .OnClick("function() { window.location.href = '" + Url.Action("Create", "Survey") + "'; }")
            )
        </div>
    }
</div>

@(Html.DevExtreme().CardView<khaosat_fe.Models.SurveyViewModel>()
.ID("cardSurveys")
.DataSource(ds => ds.Mvc()
.Controller("Survey")
.LoadAction("GetSurveys")
.Key("Id")
)
.KeyExpr("Id")
.CardsPerRow(1)
.Paging(p => p.PageSize(6))
.SearchPanel(s => s.Visible(true).Width(300).Placeholder("Tìm kiếm khảo sát..."))
.CardTemplate(@<text>
<div class="card survey-row-card shadow-sm" style="overflow: hidden;">
    <div class="card-body py-3 ps-4 pe-3">
        <div class="d-flex flex-row align-items-center justify-content-between flex-nowrap gap-3">
            <!-- Nhóm bên trái: Tên + Mã + Badge + Stats -->
            <div class="d-flex flex-column gap-1" style="min-width: 0; flex: 1;">
                <div class="d-flex flex-row align-items-center gap-2 flex-wrap">
                    <h5 class="card-title text-dark fw-bold mb-0" style="font-size: 1rem; letter-spacing: -0.01em; white-space: nowrap;"><%- card.data.Name %></h5>
                    <span class="text-muted small" style="font-size: 0.85rem;">#<%- card.data.Code %></span>
                    <span class="badge <%- card.data.Status == 1 ? 'bg-success-subtle text-success border border-success-subtle' : 'bg-secondary-subtle text-secondary border border-secondary-subtle' %> px-2 py-1 rounded-pill">
                        <%- card.data.Status == 1 ? 'Đang mở' : 'Đã đóng' %>
                    </span>
                </div>
                <div class="d-flex flex-row gap-3">
                    <span class="text-muted small" style="font-size: 0.85rem;">
                        <i class="dx-icon-chart"></i> <%- card.data.CompletedCount %> / <%- card.data.TotalResponses %> responses
                    </span>
                    <span class="text-muted small" style="font-size: 0.85rem;">
                        <i class="dx-icon-clock"></i> <%- card.data.StartDate ? DevExpress.localization.formatDate(new Date(card.data.StartDate), "dd/MM/yyyy HH:mm") : "N/A" %>
                    </span>
                </div>
            </div>

            <!-- Nhóm bên phải: Completion Rate + Buttons -->
            <div class="d-flex flex-row align-items-center gap-3" style="flex-shrink: 0;">
                <div class="d-flex flex-column justify-content-center align-items-center">
                    <p class="text-dark mb-0 fs-4"><%- card.data.CompletionRate %>%</p>
                    <p class="text-muted mb-0 small" style="font-size: 0.8rem;">completion</p>
                </div>
                <div class="d-flex flex-row gap-2 justify-content-center align-items-center">
                    <a class="btn btn-outline-primary px-3 py-2 btn-sm fw-semibold survey-btn-pill <%- card.data.Status != 1 ? 'disabled' : '' %>" href="/Survey/Detail/<%- card.data.Id %>" style="font-size: 0.85rem;">
                        <i class="dx-icon-eyeopen"></i> Làm khảo sát
                    </a>
                    @if (User.IsInRole("Admin") || User.IsInRole("Quản lý"))
                    {
                        <a class="btn btn-outline-secondary px-2 py-2 btn-sm survey-btn-pill <%- card.data.StartDate && new Date(card.data.StartDate) <= new Date() ? 'disabled' : '' %>" href="/Survey/Edit/<%- card.data.Id %>" title="Sửa">
                            <i class="dx-icon-edit"></i>
                        </a>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
</text>)
 )
