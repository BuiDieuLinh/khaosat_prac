@{
    ViewData["Title"] = "Tạo khảo sát mới";
}

<div class="survey-builder">
    <div class="builder-page-header mb-4">
        <a href="@Url.Action("Index", "Survey")" class="btn btn-outline-secondary btn-sm mb-3" style="border-radius: 4px !important;">
            <i class="dx-icon-arrowleft"></i> Quay lại danh sách
        </a>
        <h1 class="fw-bold text-dark mb-1">@ViewData["Title"]</h1>
        <p class="text-muted mb-0">Tạo mới bài khảo sát với quy trình Wizard 4 bước chuyên nghiệp.</p>
    </div>

    <div class="wizard-stepper-container mb-4">
        <div class="wizard-stepper">
            <div class="wizard-step active" id="stepIndicator1" onclick="window.Survey.Wizard.goToStep(1)">
                <div class="step-badge">1</div>
                <div class="step-label">
                    <span class="step-title">Thông tin khảo sát</span>
                    <span class="step-sub">Mã, Tên, Số lần làm</span>
                </div>
            </div>
            <div class="wizard-step-divider"></div>
            <div class="wizard-step" id="stepIndicator2" onclick="window.Survey.Wizard.goToStep(2)">
                <div class="step-badge">2</div>
                <div class="step-label">
                    <span class="step-title">Đối tượng khảo sát</span>
                    <span class="step-sub">Phạm vi gửi bài</span>
                </div>
            </div>
            <div class="wizard-step-divider"></div>
            <div class="wizard-step" id="stepIndicator3" onclick="window.Survey.Wizard.goToStep(3)">
                <div class="step-badge">3</div>
                <div class="step-label">
                    <span class="step-title">Thiết lập câu hỏi</span>
                    <span class="step-sub">Tiêu chí & Options</span>
                </div>
            </div>
            <div class="wizard-step-divider"></div>
            <div class="wizard-step" id="stepIndicator4" onclick="window.Survey.Wizard.goToStep(4)">
                <div class="step-badge">4</div>
                <div class="step-label">
                    <span class="step-title">Xem trước & Lưu</span>
                    <span class="step-sub">Xác nhận thông tin</span>
                </div>
            </div>
        </div>
    </div>

    <div class="wizard-content-step" id="wizardStep1">
        <div class="card border-0 shadow-sm p-3 mb-4">
            <div class="card-body">
                <div class="step-header-card d-flex align-items-center gap-3 mb-4">
                    <div class="step-header-icon-box">
                        <i class="dx-icon-info fs-4"></i>
                    </div>
                    <div>
                        <h5 class="fw-bold text-dark mb-1">Cấu hình thông tin cuộc khảo sát</h5>
                        <p class="text-muted small mb-0">Nhập mã, tiêu đề, thời gian diễn ra và số lần khảo sát tối đa.</p>
                    </div>
                </div>

                <div class="row g-3">
                    <div class="col-md-4">
                        <label class="form-label text-secondary small">Mã khảo sát <span class="text-danger">*</span></label>
                        @(Html.DevExtreme().TextBox()
                            .ID("surveyCode")
                            .Placeholder("Ví dụ: KS_NV_2026")
                        )
                    </div>
                    <div class="col-md-8">
                        <label class="form-label text-secondary small">Tên khảo sát <span class="text-danger">*</span></label>
                        @(Html.DevExtreme().TextBox()
                            .ID("surveyName")
                            .Placeholder("Nhập tiêu đề cuộc khảo sát...")
                        )
                    </div>
                    <div class="col-12">
                        <label class="form-label text-secondary small">Mô tả khảo sát</label>
                        @(Html.DevExtreme().TextArea()
                            .ID("surveyDescription")
                            .Placeholder("Mô tả tóm tắt mục đích cuộc khảo sát...")
                            .Height(80)
                        )
                    </div>
                    <div class="col-md-4">
                        <label class="form-label text-secondary small">Ngày bắt đầu <span class="text-danger">*</span></label>
                        @(Html.DevExtreme().DateBox()
                            .ID("surveyStartDate")
                            .Type(DateBoxType.DateTime)
                            .DisplayFormat("dd/MM/yyyy HH:mm")   
                            .Placeholder("Chọn ngày bắt đầu")
                            .Value(DateTime.Now)
                        )
                    </div>
                    <div class="col-md-4">
                        <label class="form-label text-secondary small">Ngày kết thúc</label>
                        @(Html.DevExtreme().DateBox()
                            .ID("surveyEndDate")
                            .Type(DateBoxType.DateTime)
                            .DisplayFormat("dd/MM/yyyy HH:mm")
                            .Placeholder("Để trống nếu không giới hạn")
                        )
                    </div>
                    <div class="col-md-4">
                        <label class="form-label text-secondary small">Số lần làm tối đa (Max Attempts)</label>
                        @(Html.DevExtreme().NumberBox()
                            .ID("surveyMaxAttempts")
                            .Min(1)
                            .Step(1)
                            .Placeholder("Nhập số (VD: 1, 3) hoặc để trống = Unlimited")
                        )
                    </div>
                    <div class="col-md-4">
                        <label class="form-label text-secondary small">Trạng thái phát hành</label>
                        @(Html.DevExtreme().SelectBox()
                            .ID("surveyStatus")
                            .DataSource(new[] {
                                new { Value = (byte)1, Text = "Đang mở (Published)" },
                                new { Value = (byte)0, Text = "Lưu nháp (Draft)" }
                            })
                            .ValueExpr("Value")
                            .DisplayExpr("Text")
                            .Value((byte)1)
                        )
                    </div>
                    <div class="col-md-4">
                        <label class="form-label text-secondary small">Loại truy cập (Access Type)</label>
                        @(Html.DevExtreme().SelectBox()
                            .ID("surveyAccessType")
                            .DataSource(new[] {
                                new { Value = 1, Text = "Internal (Nội bộ hệ thống)" },
                                new { Value = 2, Text = "Public (Công khai qua Link)" }
                            })
                            .ValueExpr("Value")
                            .DisplayExpr("Text")
                            .Value(1)
                            .OnValueChanged("function(e) { window.Survey.Wizard.onAccessTypeChanged(e); }")
                        )
                    </div>
                    <div class="col-md-4 d-flex align-items-end">
                        <div class="p-2 border rounded-3 bg-light w-100">
                            @(Html.DevExtreme().CheckBox()
                                .ID("surveyAnonymousMode")
                                .Text("Bật chế độ Ẩn danh (Internal Anonymous)")
                                .Value(false)
                            )
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="wizard-content-step" id="wizardStep2" style="display: none;">
        <div class="card border-0 shadow-sm p-3 mb-4">
            <div class="card-body">
                <div class="step-header-card d-flex align-items-center gap-3 mb-4">
                    <div class="step-header-icon-box">
                        <i class="dx-icon-group fs-4"></i>
                    </div>
                    <div>
                        <h5 class="fw-bold text-dark mb-1">Chọn đối tượng nhận khảo sát</h5>
                        <p class="text-muted small mb-0">Xác định nhân sự sẽ nhận và thực hiện cuộc khảo sát này.</p>
                    </div>
                </div>

                <div class="mb-4 p-3 bg-light rounded-3 border">
                    <div class="d-flex align-items-center">
                        @(Html.DevExtreme().CheckBox()
                            .ID("isWholeCompany")
                            .Text("Phát hành cho Toàn bộ Công ty (Whole Company)")
                            .Value(true)
                            .OnValueChanged("function(e) { window.Survey.Wizard.onWholeCompanyChanged(e); }")
                        )
                    </div>
                </div>

                <div class="row g-4" id="targetSpecificGroup" style="display: none;">
                    <div class="col-md-12">
                        <label class="form-label text-dark fw-semibold small">
                            Chọn phòng ban / chức vụ áp dụng
                        </label>

                        @(Html.DevExtreme().TreeView()
                            .ID("targetTree")
                            .DataSource(d => d.Mvc()
                                .Controller("Department")
                                .LoadAction("GetDepartments"))
                            .DataStructure(TreeViewDataStructure.Tree)
                            .KeyExpr("Id")
                            .DisplayExpr(new JS("window.Survey.Wizard.getTreeNodeDisplayExpr"))
                            .ItemsExpr("Positions")
                            .ExpandedExpr("Expanded")
                            .SelectionMode(NavSelectionMode.Multiple)
                            .ShowCheckBoxesMode(TreeViewCheckBoxMode.Normal)
                            .SelectNodesRecursive(true)
                            .ExpandNodesRecursive(true)
                            .OnContentReady("function(e) { window.Survey.Wizard.onTreeContentReady(e); }")
                        )
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="wizard-content-step" id="wizardStep3" style="display: none;">
        <div class="card border-0 shadow-sm p-3 mb-4">
            <div class="card-body">
                <div class="step-header-card d-flex align-items-center justify-content-between mb-4">
                    <div class="d-flex align-items-center gap-3">
                        <div class="step-header-icon-box">
                            <i class="dx-icon-card fs-4"></i>
                        </div>
                        <div>
                            <h5 class="fw-bold text-dark mb-1">Thiết lập câu hỏi khảo sát</h5>
                            <p class="text-muted small mb-0">Thêm, chỉnh sửa, sắp xếp các câu hỏi và tiêu chí đánh giá.</p>
                        </div>
                    </div>
                    <div class="d-flex gap-2">
                        @(Html.DevExtreme().Button()
                            .Text("Nhập từ Excel")
                            .Type(ButtonType.Normal)
                            .Icon("import")
                            .StylingMode(ButtonStylingMode.Outlined)
                            .OnClick("window.Survey.Event.showImportPopup")
                        )
                        @(Html.DevExtreme().Button()
                            .Text("Thêm câu hỏi mới")
                            .Type(ButtonType.Default)
                            .Icon("add")
                            .OnClick("window.Survey.Element.addQuestion")
                        )
                    </div>
                </div>

                <div id="questionsContainer" class="d-flex flex-column gap-3">
                    <div id="emptyState" class="text-center py-4 text-muted">
                        <i class="dx-icon-help-outline fs-2"></i>
                        <p class="mt-2 mb-0">Chưa có câu hỏi nào được thêm. Nhấn "Thêm câu hỏi mới" ở trên để khởi tạo.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="wizard-content-step" id="wizardStep4" style="display: none;">
        <div id="previewContent"></div>
    </div>

    <div class="d-flex justify-content-between align-items-center mt-4">
        <button type="button" class="btn btn-outline-secondary px-4" id="btnWizardBack" style="display: none; border-radius: 4px !important;" onclick="window.Survey.Wizard.prevStep()">
            <i class="dx-icon-arrowleft me-1"></i> Quay lại
        </button>
        <div></div>
        <div class="d-flex gap-2">
            <button type="button" class="btn btn-primary px-4" id="btnWizardNext" style="border-radius: 4px !important;" onclick="window.Survey.Wizard.nextStep()">
                Tiếp tục <i class="dx-icon-arrowright ms-1"></i>
            </button>
            <button type="button" class="btn btn-success px-4" id="btnWizardSave" style="display: none; border-radius: 4px !important; background-color: #059669 !important; border-color: #059669 !important;" onclick="window.Survey.Event.saveSurvey()">
                <i class="dx-icon-save me-1"></i> Lưu & Phát hành khảo sát
            </button>
        </div>
    </div>
</div>


@(Html.DevExtreme().Popup()
    .ID("importExcelPopup")
    .Title("Nhập câu hỏi từ Excel")
    .Width(550)
    .Height(480)
    .Visible(false)
    .DragEnabled(true)
    .OnHidden("function(e) { window.Survey.Event.onImportPopupHidden(e); }")
    .ContentTemplate(@<text>
        <div class="alert alert-secondary small mb-3">
            <strong>Hướng dẫn:</strong> Tải file mẫu, điền các câu hỏi và chọn tệp để nhập. Đối với câu hỏi trắc nghiệm (Radio/Checkbox), các đáp án viết dưới dạng <code>Mã: Tên hiển thị</code>, phân tách bằng dấu chấm phẩy (;). Ví dụ: <code>1: Rất tốt; 2: Bình thường</code>.
        </div>

        <div class="d-flex justify-content-between align-items-center mb-3 pb-3 border-bottom">
            <span class="small text-muted">Bước 1: Tải cấu trúc câu hỏi mẫu</span>
            @(Html.DevExtreme().Button()
                .Text("Tải file mẫu (.xlsx)")
                .Type(ButtonType.Normal)
                .StylingMode(ButtonStylingMode.Outlined)
                .Icon("download")
                .OnClick("window.Survey.Event.downloadTemplate")
            )
        </div>

        <div class="mb-3">
            <label class="form-label small fw-bold mb-1">Bước 2: Chọn tệp Excel đã điền:</label>
            @(Html.DevExtreme().FileUploader()
                .ID("importExcelFile")
                .SelectButtonText("Chọn tệp Excel")
                .LabelText("")
                .Accept(".xlsx, .xls")
                .UploadMode(FileUploadMode.UseForm)
                .OnValueChanged("function(e) { window.Survey.Event.handleExcelUpload(e); }")
            )
        </div>

        <div class="mb-3">
            <label class="form-label small fw-bold mb-1">Tùy chọn nhập:</label>
            @(Html.DevExtreme().RadioGroup()
                .ID("importMode")
                .DataSource(new[] {
                    new { Value = "overwrite", Text = "Ghi đè danh sách cũ" },
                    new { Value = "append", Text = "Nối tiếp vào cuối" }
                })
                .ValueExpr("Value")
                .DisplayExpr("Text")
                .Value("overwrite")
                .Layout(Orientation.Horizontal)
            )
        </div>

        <div class="d-flex justify-content-end gap-2 mt-4 pt-3 border-top">
            @(Html.DevExtreme().Button()
                .Text("Hủy bỏ")
                .Type(ButtonType.Normal)
                .StylingMode(ButtonStylingMode.Outlined)
                .OnClick("function() { $('#importExcelPopup').dxPopup('instance').hide(); }")
            )
            @(Html.DevExtreme().Button()
                .Text("Thực hiện nhập")
                .Type(ButtonType.Default)
                .OnClick("window.Survey.Event.executeImport")
            )
        </div>
    </text>)
)

<script>
    window.Survey = window.Survey || {};
    window.Survey.Urls = {
        createNested: "@Url.Action("CreateNested", "Survey")",
        index: "@Url.Action("Index", "Survey")"
    };
</script>

<script src="~/js/devextreme/jszip.min.js"></script>
<script src="~/js/devextreme/dx-exceljs-fork.min.js"></script>
<script src="~/js/devextreme/FileSaver.min.js"></script>
<script src="~/js/common.js" asp-append-version="true"></script>
<script src="~/js/survey/survey-constants.js" asp-append-version="true"></script>
<script src="~/js/survey/survey-api.js" asp-append-version="true"></script>
<script src="~/js/survey/survey-validation.js" asp-append-version="true"></script>
<script src="~/js/survey/survey-builder.js" asp-append-version="true"></script>
<script src="~/js/survey/survey-wizard.js" asp-append-version="true"></script>
<script src="~/js/survey/survey-page.js" asp-append-version="true"></script>
